<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="web_layout_favicon" inherit_id="web.layout" name="Browser Tab Favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="before">
            <!-- Only fill x_icon when no other template already set it. website.layout
                 and webclient_scoped_app both provide their own value, and whichever
                 runs first must win. -->
            <t t-if="not x_icon">
                <t t-set="spm_company" t-value="request.env.company.sudo()"/>
                <!-- Leave x_icon falsy when no icon is uploaded, so web.layout falls
                     back to its own default instead of serving the image placeholder. -->
                <t t-set="x_icon"
                   t-value="'/web/image/res.company/%s/favicon?unique=%s' % (spm_company.id, spm_company.spm_favicon_token) if spm_company.favicon else False"/>
            </t>
        </xpath>
    </template>

    <template id="login_layout_branding" inherit_id="web.login_layout" name="Login Layout Branding">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="before">
            <t t-set="spm_preview_title"
               t-value="res_company.spm_social_preview_title or 'finpal.pk'"/>
            <t t-set="spm_base_url"
               t-value="request.env['ir.config_parameter'].sudo().get_str('web.base.url', '')"/>
            <t t-set="head">
                <meta property="og:title" t-att-content="spm_preview_title"/>
                <meta property="og:site_name" t-att-content="spm_preview_title"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-att-content="spm_base_url"/>
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:title" t-att-content="spm_preview_title"/>
                <t t-if="res_company.spm_social_preview_logo">
                    <t t-set="spm_preview_image"
                       t-value="'%s/web/image/res.company/%s/spm_social_preview_logo' % (spm_base_url, res_company.id)"/>
                    <meta property="og:image" t-att-content="spm_preview_image"/>
                    <meta property="og:image:secure_url" t-att-content="spm_preview_image"/>
                    <meta name="twitter:image" t-att-content="spm_preview_image"/>
                </t>
                <t t-elif="not res_company.uses_default_logo">
                    <t t-set="spm_preview_image"
                       t-value="'%s/web/image/res.company/%s/logo' % (spm_base_url, res_company.id)"/>
                    <meta property="og:image" t-att-content="spm_preview_image"/>
                    <meta property="og:image:secure_url" t-att-content="spm_preview_image"/>
                    <meta name="twitter:image" t-att-content="spm_preview_image"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.frontend_layout']" position="attributes">
            <attribute name="spm_preview_title">spm_preview_title</attribute>
            <attribute name="spm_base_url">spm_base_url</attribute>
            <attribute name="title">spm_preview_title</attribute>
            <attribute name="head">head</attribute>
        </xpath>
    </template>

    <template id="login_layout_poweredby" inherit_id="web.login_layout" name="Login Layout Powered By">
        <xpath expr="//a[@target='_blank']" position="replace">
            <t t-set="spm_icp" t-value="request.env['ir.config_parameter'].sudo()"/>
            <t t-set="spm_show_poweredby" t-value="spm_icp.get_bool('spm_show_poweredby')"/>
            <t t-if="spm_show_poweredby">
                <a t-att-href="spm_icp.get_str('spm_poweredby_url', 'https://www.odoo.com?utm_source=db&amp;utm_medium=auth')"
                   target="_blank">
                    <t t-out="spm_icp.get_str('spm_poweredby_text', 'Powered by Odoo')"/>
                </a>
            </t>
        </xpath>
    </template>

</odoo>
