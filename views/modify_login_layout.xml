<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="login_layout_branding" inherit_id="web.login_layout" name="Login Layout Branding">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="inside">
            <t t-set="title" t-value="res_company.name"/>
            <t t-set="head">
                <meta property="og:title" t-att-content="res_company.name"/>
                <meta property="og:site_name" t-att-content="res_company.name"/>
                <meta property="og:type" content="website"/>
                <t t-if="not res_company.uses_default_logo">
                    <meta property="og:image" t-attf-content="/web/binary/company_logo{{ '?dbname=' + db if db else '' }}"/>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
