<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_spm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo_social_preview_modifier</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Branding"
                     id="odoo_social_preview_modifier_settings"
                     string="Branding"
                     name="odoo_social_preview_modifier">

                    <block title="Social preview" id="spm_social_preview_block">
                        <setting string="Preview title"
                                 help="Title shown in link previews on social apps (WhatsApp, Facebook, LinkedIn, X/Twitter, Slack, etc.). Leave empty to use finpal.pk.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="spm_social_preview_title"
                                             placeholder="finpal.pk"
                                             class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Preview logo"
                                 help="Image shown in link previews on social apps (WhatsApp, Facebook, LinkedIn, X/Twitter, Slack, etc.). Leave empty to use the company logo.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="spm_social_preview_logo"
                                             filename="spm_social_preview_logo_filename"
                                             widget="image"
                                             class="w-25"/>
                                    <field name="spm_social_preview_logo_filename" invisible="1"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Login footer" id="spm_login_footer">
                        <setting string="Show Powered by"
                                 help="Show or hide the Powered by link on the login page.">
                            <field name="spm_show_poweredby"/>
                            <div class="content-group" invisible="not spm_show_poweredby">
                                <div class="row mt16">
                                    <label for="spm_poweredby_text" class="col-lg-3 o_light_label"/>
                                    <field name="spm_poweredby_text" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="spm_poweredby_url" class="col-lg-3 o_light_label"/>
                                    <field name="spm_poweredby_url" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="User menu" id="spm_user_menu">
                        <setting string="Show Documentation"
                                 help="Show or hide Documentation in the user menu.">
                            <field name="spm_show_documentation"/>
                            <div class="content-group" invisible="not spm_show_documentation">
                                <div class="row mt16">
                                    <label for="spm_documentation_text" class="col-lg-3 o_light_label"/>
                                    <field name="spm_documentation_text" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="spm_documentation_url" class="col-lg-3 o_light_label"/>
                                    <field name="spm_documentation_url" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>

                        <setting string="Show Support"
                                 help="Show or hide Support in the user menu.">
                            <field name="spm_show_support"/>
                            <div class="content-group" invisible="not spm_show_support">
                                <div class="row mt16">
                                    <label for="spm_support_text" class="col-lg-3 o_light_label"/>
                                    <field name="spm_support_text" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="spm_support_url" class="col-lg-3 o_light_label"/>
                                    <field name="spm_support_url" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>

                        <setting string="Show My Odoo.com account"
                                 help="Show or hide My Odoo.com account in the user menu.">
                            <field name="spm_show_account"/>
                            <div class="content-group" invisible="not spm_show_account">
                                <div class="row mt16">
                                    <label for="spm_account_text" class="col-lg-3 o_light_label"/>
                                    <field name="spm_account_text" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="spm_account_url" class="col-lg-3 o_light_label"/>
                                    <field name="spm_account_url" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
